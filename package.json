  "type": "commonjs",
  "devDependencies": {
    "@parcel/transformer-sass": "^2.16.4",
    "npm-run-all": "^4.1.5",
    "parcel": "^2.16.4",
    "posthtml-modules": "^0.9.1",
    "rimraf": "^6.1.3",
    "sass": "^1.98.0"
  },
  "dependencies": {
    "posthtml-extend": "^0.6.5",
    "posthtml-include": "^2.0.1",
    "typed.js": "^3.0.0"
  }
